# ===============================================================
# Rehavid Operaciones · Variables de entorno
# Copiar este archivo como .env y completar valores.
# En producción usar Azure Key Vault, NO commitear .env real.
# ===============================================================

# General
APP_NAME="Rehavid Operaciones API"
ENVIRONMENT=development
DEBUG=true

# Cosmos DB (Azure) · obtener desde portal.azure.com
COSMOS_ENDPOINT=https://rehavid-cosmos.documents.azure.com:443/
COSMOS_KEY=<obtener-del-portal>
COSMOS_DATABASE=rehavid
# Poner en false SOLO con el emulador local (cert self-signed). En Azure: true.
COSMOS_CONNECTION_VERIFY=true

# Blob Storage
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
BLOB_CONTAINER_LOGOS=logos
BLOB_CONTAINER_ATTACHMENTS=attachments

# Microsoft Entra ID (Azure AD) · registrar app en portal.azure.com
AZURE_TENANT_ID=<tenant-id-de-rehavid>
AZURE_CLIENT_ID=<client-id-app>
AZURE_CLIENT_SECRET=<client-secret>
AZURE_AUTHORITY=https://login.microsoftonline.com/<tenant-id>

# Azure ML · endpoint del modelo predictivo
# Mientras AZURE_ML_ENABLED=false, el backend devuelve la simulación.
# Cuando se entrene el modelo y se despliegue en Azure ML, cambiar a true.
AZURE_ML_ENDPOINT=
AZURE_ML_KEY=
AZURE_ML_DEPLOYMENT=rehavid-risk-v1
AZURE_ML_ENABLED=false

# JWT · generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generar-secreto-seguro>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=["http://localhost:3000","https://operaciones.rehavid.com.co"]

# Application Insights · telemetría y auditoría
APPINSIGHTS_CONNECTION_STRING=
